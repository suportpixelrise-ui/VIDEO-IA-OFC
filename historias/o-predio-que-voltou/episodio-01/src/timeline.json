    },
    {
      "start": 5.148053872715878,
      "end": 7.176346387799994,
      "text": "No lugar do prédio dele,"
    },
    {
      "start": 7.216346387799994,
      "end": 9.090000000000002,
      "text": "encontrou um terreno vazio."
    },
    {
      "start": 10.541770833333333,
      "end": 13.25287233538158,
      "text": "Não havia escombros."
    },
    {
      "start": 13.292872335381581,
      "end": 17.171770833333333,
      "text": "A construção inteira tinha sumido durante a madrugada."
    },
    {
      "start": 18.471937500000003,
      "end": 23.46476676678418,
      "text": "Outros prédios começaram a desaparecer também."
    },
    {
      "start": 23.50476676678418,
      "end": 25.495536473312306,
      "text": "Sem encontrar o irmão,"
    },
    {
      "start": 25.535536473312305,
      "end": 28.641937500000004,
      "text": "Lia se refugiou numa escola com os sobreviventes."
    },
    {
      "start": 29.867375000000003,
      "end": 32.637375,
      "text": "Hoje, eles vão deixar a cidade."
    },
    {
      "start": 33.96429166666667,
      "end": 37.91897065635097,
      "text": "O último ônibus do abrigo está pronto."
    },
    {
      "start": 37.95897065635097,
      "end": 42.05506797384042,
      "text": "Lia entra na fila, mas uma luz do outro lado da rua"
    },
    {
      "start": 42.09506797384042,
      "end": 43.21429166666667,
      "text": "faz ela parar."
    },
    {
      "start": 44.56179166666667,
      "end": 47.49179166666667,
      "text": "O prédio do irmão está lá outra vez."
    },
    {
      "start": 49.214645833333336,
      "end": 53.184645833333335,
      "text": "Ela atravessa a rua e se aproxima da janela do térreo."
    },
    {
      "start": 54.300270833333336,
      "end": 59.35913896595896,
      "text": "Lá dentro, o irmão está sentado com os vizinhos."
    },
    {
      "start": 59.39913896595896,
      "end": 62.370513888410194,
      "text": "Há comida quente na mesa."
    },
    {
      "start": 62.41051388841019,
      "end": 65.33027083333333,
      "text": "Eles jantam como se nada tivesse acontecido."
    },
    {
      "start": 66.60070833333333,
      "end": 68.21070833333333,
      "text": "Lia bate no vidro."
    },
    {
      "start": 69.73183333333333,
      "end": 71.26183333333333,
      "text": "Ninguém responde."
    },
    {
      "start": 73.09002083333333,
      "end": 76.38133326103227,
      "text": "Então o irmão olha para ela e puxa a única"
    },
    {
      "start": 76.42133326103226,
      "end": 77.54002083333333,
      "text": "cadeira vazia."
    },
    {
      "start": 79.53656249999999,
      "end": 82.75609043710715,
      "text": "A buzina faz Lia se virar."
    },
    {
      "start": 82.79609043710714,
      "end": 85.2465625,
      "text": "O ônibus está começando a andar."
    },
    {
      "start": 86.39410416666665,
      "end": 90.32735432950713,
      "text": "Ela pode entrar e tentar buscar o irmão."
    },
    {
      "start": 90.36735432950712,
      "end": 93.92410416666665,
      "text": "Mas, se demorar, vai ficar para trás."
    },
    {
      "start": 95.05016666666666,
      "end": 98.36016666666666,
      "text": "Ou pode pegar o ônibus… e deixá-lo ali."
    },
    {
      "start": 99.76102083333332,
      "end": 101.59102083333333,
      "text": "O que Lia deve fazer?"
    },
    {
      "start": 102.78814583333332,
      "end": 104.71814583333332,
      "text": "A: entrar no prédio."
    },
    {
      "start": 105.91839583333332,
      "end": 107.82839583333333,
      "text": "B: pegar o ônibus."
    },
    {
      "start": 109.11052083333333,
      "end": 111.47291927183875,
      "text": "Comente A ou B."
    },
    {
      "start": 111.51291927183875,
      "end": 114.52052083333334,
      "text": "A escolha mais votada vira a continuação."
    }
  ],
